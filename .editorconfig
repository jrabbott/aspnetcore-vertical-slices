root = true

# ================================================================
# CORE EDITORCONFIG
# ================================================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

# ================================================================
# C#
# ================================================================

[*.cs]

# ------------------------------------------------
# Formatting
# ------------------------------------------------

csharp_indent_block_contents = true
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_labels = one_less_than_current

csharp_new_line_before_open_brace = all
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_chained_calls = true
csharp_new_line_between_query_expression_clauses = true

csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_parentheses = false

csharp_style_allow_embedded_statements_on_same_line = false:warning
csharp_style_allow_blank_line_after_colon_in_constructor_initializer = false:warning
csharp_style_allow_blank_line_after_token_in_conditional_expression = false:warning
csharp_style_allow_blank_line_after_token_in_arrow_expression_clause = false:warning

# Braces are mandatory.
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# Formatting itself is part of the contract.
dotnet_diagnostic.IDE0055.severity = error

# ------------------------------------------------
# Modern C# language constructs
# ------------------------------------------------

csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error

csharp_style_prefer_pattern_matching_over_is_with_cast_check = true:error
csharp_style_prefer_pattern_matching_over_as_with_null_check = true:error
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_extended_property_pattern = true:warning
csharp_style_prefer_switch_expression = true:warning

csharp_style_throw_expression = true:warning
csharp_style_conditional_delegate_call = true:warning
csharp_style_prefer_primary_constructors = true:warning

csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_style_prefer_collection_expression = true:warning
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0305.severity = warning

# Nitpicks — do not burn reasoning budget.
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_utf8_string_literals = true:suggestion

dotnet_style_prefer_nameof_expression = true:error
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error
dotnet_style_prefer_inferred_tuple_names = true:warning
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
dotnet_style_explicit_tuple_names = true:error

csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning

# ------------------------------------------------
# var policy (conservative)
# ------------------------------------------------
# var when the type is obvious from the RHS; otherwise explicit.

csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning

# ------------------------------------------------
# Usings
# ------------------------------------------------

csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true:error
dotnet_separate_import_directive_groups = false:error
dotnet_diagnostic.IDE0005.severity = error

# ------------------------------------------------
# Accessibility / qualification
# ------------------------------------------------

dotnet_style_require_accessibility_modifiers = always:error
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# ------------------------------------------------
# Expression / member preferences
# ------------------------------------------------

dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_compound_assignment = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_simplified_interpolation = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:warning
dotnet_style_prefer_conditional_expression_over_return = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_string_interpolation = true:warning
dotnet_style_readonly_field = true:warning
dotnet_remove_unnecessary_casts = true:error
dotnet_diagnostic.IDE0004.severity = error

csharp_style_expression_bodied_methods = false:warning
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_operators = false:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_indexers = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = false:warning

# ------------------------------------------------
# Naming
# ------------------------------------------------

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.interface_prefix_I.capitalization = pascal_case
dotnet_naming_style.interface_prefix_I.required_prefix = I

dotnet_naming_style.private_field_style.capitalization = camel_case
dotnet_naming_style.private_field_style.required_prefix = _

dotnet_naming_style.type_parameter_style.capitalization = pascal_case
dotnet_naming_style.type_parameter_style.required_prefix = T

dotnet_naming_symbols.types.applicable_kinds = class,struct,interface,enum,delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.types_should_be_pascal_case.severity = error

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_rule.interfaces_should_start_with_I.symbols = interfaces
dotnet_naming_rule.interfaces_should_start_with_I.style = interface_prefix_I
dotnet_naming_rule.interfaces_should_start_with_I.severity = error

dotnet_naming_symbols.members.applicable_kinds = method,property,event
dotnet_naming_symbols.members.applicable_accessibilities = *

dotnet_naming_rule.members_should_be_pascal_case.symbols = members
dotnet_naming_rule.members_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.members_should_be_pascal_case.severity = error

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter,local
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

dotnet_naming_rule.locals_and_parameters_should_be_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.style = camel_case
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.severity = error

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_rule.private_fields_should_be_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.style = private_field_style
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.severity = error

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *

dotnet_naming_rule.type_parameters_should_start_with_T.symbols = type_parameters
dotnet_naming_rule.type_parameters_should_start_with_T.style = type_parameter_style
dotnet_naming_rule.type_parameters_should_start_with_T.severity = error

# ------------------------------------------------
# Analyzer category policy
# ------------------------------------------------

dotnet_analyzer_diagnostic.category-Security.severity = error
dotnet_analyzer_diagnostic.category-Reliability.severity = error
dotnet_analyzer_diagnostic.category-Interoperability.severity = error
dotnet_analyzer_diagnostic.category-Performance.severity = warning
dotnet_analyzer_diagnostic.category-Design.severity = warning
dotnet_analyzer_diagnostic.category-Usage.severity = warning
dotnet_analyzer_diagnostic.category-Maintainability.severity = warning

# ------------------------------------------------
# High-value rule overrides
# ------------------------------------------------

# Unused / redundant code and suppressions.
dotnet_diagnostic.IDE0079.severity = error
dotnet_diagnostic.IDE0370.severity = error

# Dispose / exception / API correctness.
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA1063.severity = error
dotnet_diagnostic.CA2200.severity = error
dotnet_diagnostic.CA2201.severity = error
dotnet_diagnostic.CA2208.severity = error
dotnet_diagnostic.CA2214.severity = error
dotnet_diagnostic.CA1062.severity = error
dotnet_diagnostic.CA2254.severity = error
dotnet_diagnostic.CA2264.severity = error

# Async / ValueTask.
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA2012.severity = error
dotnet_diagnostic.CS4014.severity = warning

# Known weak crypto (also covered by Security category; explicit for clarity).
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5351.severity = error

# Noisy perf nit — preference only.
dotnet_diagnostic.CA1861.severity = suggestion

# Code metrics (disabled by default in .NET 10 — enable explicitly).
# Thresholds live in CodeMetricsConfig.txt (AdditionalFiles).
dotnet_diagnostic.CA1501.severity = warning
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1505.severity = warning
dotnet_diagnostic.CA1506.severity = warning
dotnet_diagnostic.CA1509.severity = error

# XML docs not required yet.
dotnet_diagnostic.CS1591.severity = none

# Obsolete APIs are real violations.
dotnet_diagnostic.CS0618.severity = error
dotnet_diagnostic.CS0612.severity = error

# ------------------------------------------------
# Nullable correctness (selective gate; not global warn-as-error)
# ------------------------------------------------

dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8601.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8605.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8619.severity = error
dotnet_diagnostic.CS8620.severity = error
dotnet_diagnostic.CS8625.severity = error
dotnet_diagnostic.CS8629.severity = error

# ================================================================
# TEST CODE
# ================================================================

[**/{*Tests,*Test}.cs]
dotnet_diagnostic.IDE1006.severity = warning
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1506.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA1506.severity = none
dotnet_diagnostic.CA2000.severity = none

# ================================================================
# GENERATED CODE
# ================================================================

[**/obj/**]
generated_code = true

[**/bin/**]
generated_code = true

[**/*.g.cs]
generated_code = true

[**/*.generated.cs]
generated_code = true

# ================================================================
# NON-C# FILE FORMATS
# ================================================================

[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
